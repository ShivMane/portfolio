# ──────────────────────────────────────────────────────
# Contact form (Resend)
# ──────────────────────────────────────────────────────
# 1. Create a free account at https://resend.com
# 2. Generate an API key (Settings → API Keys)
# 3. Verify your sending domain (or use resend.dev for testing)
# 4. Set CONTACT_EMAIL to the address you want to receive messages

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=hello@yourdomain.com

# Optional: the "From" address shown to recipients.
# Must match a verified domain in your Resend account.
# Defaults to "onboarding@resend.dev" if omitted.
FROM_EMAIL=portfolio@yourdomain.com

# ──────────────────────────────────────────────────────
# Site URL (used for sitemap / canonical links)
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
