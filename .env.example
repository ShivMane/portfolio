# ──────────────────────────────────────────────────────
# Contact form (Formspree)
# ──────────────────────────────────────────────────────
# 1. Create a free account at https://formspree.io
# 2. Create a new form and copy its ID (the part after /f/ in the endpoint)
# 3. Either paste it into data/config.ts (contact.formspreeId)
#    or set it here / in Vercel → Settings → Environment Variables
NEXT_PUBLIC_FORMSPREE_ID=xyzabcde

# Optional: Google Search Console HTML-tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
